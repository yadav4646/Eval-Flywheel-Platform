{
  "name": "eval-flywheel-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A data flywheel for LLM agents: production traces -> curated golden dataset -> k-trial evals -> calibrated LLM judge -> regression attribution -> CI gate.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "db:seed": "tsx --disable-warning=ExperimentalWarning db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.122",
    "@ai-sdk/provider": "^4.0.39",
    "@hono/node-server": "^2.1.11",
    "ai": "^7.0.179",
    "braintrust": "^3.44.0",
    "dotenv": "^18.0.10",
    "hono": "^4.13.20",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
